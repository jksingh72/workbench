{
  "mcpServers": {
    "fetch": {
      "displayName": "🌐 MCP: Web Fetch",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false,
      "defaultSelected": true,
      "description": "Web Fetch & HTML Scraper: Fetch live web URLs and documentation directly into chat."
    },
    "sqlite": {
      "displayName": "🗄️ MCP: SQLite Database",
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-sqlite",
        "--db-path",
        "./workspace.db"
      ],
      "disabled": false,
      "defaultSelected": false,
      "description": "Local SQLite Database: Execute queries, inspect tables, and analyze database records."
    },
    "github": {
      "displayName": "🐙 MCP: GitHub",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_TOKEN_HERE"
      },
      "disabled": true,
      "defaultSelected": false,
      "description": "GitHub Integration: Manage repositories, issues, PRs, and search code. Set GITHUB_PERSONAL_ACCESS_TOKEN to activate."
    },
    "brave_search": {
      "displayName": "🦁 MCP: Brave Web Search",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY_HERE"
      },
      "disabled": true,
      "defaultSelected": false,
      "description": "Brave Web Search: Live web and local search via Brave Search API. Set BRAVE_API_KEY to activate."
    },
    "filesystem": {
      "displayName": "📂 MCP: External Filesystem",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\"
      ],
      "disabled": false,
      "defaultSelected": false,
      "description": "Extended filesystem operations across allowed host directories."
    },
    "twitter-mcp": {
      "displayName": "🐦 MCP: Twitter / X",
      "command": "npx",
      "args": [
        "-y",
        "@enescinar/twitter-mcp"
      ],
      "disabled": true,
      "defaultSelected": false,
      "description": "Twitter/X search, trends, timeline, profile, and topic analysis MCP server (requires API keys)."
    },
    "awsbrowser": {
      "displayName": "☁️ MCP: AWS Browser",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated"
      ],
      "disabled": false,
      "defaultSelected": false,
      "description": "Separate isolated Playwright browser for AWS Console."
    },
    "playwright": {
      "displayName": "🎭 MCP: Playwright Browser",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "disabled": false,
      "defaultSelected": false,
      "description": "Full browser automation (navigate, click, snapshot, screenshot)."
    },
    "oreilly": {
      "displayName": "📚 MCP: O'Reilly Books",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api.oreilly.com/api/search/v1/mcp"
      ],
      "url": "https://api.oreilly.com/api/search/v1/mcp",
      "disabled": false,
      "defaultSelected": true,
      "description": "Official O'Reilly Search MCP Server: Search O'Reilly books, chapters, and expert technical content."
    }
  },
