{
  "name": "workbench",
  "version": "0.0.1",
  "description": "Desktop workbench for technical reading, AI synthesis, and notes",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "tsx --test test/actions.test.ts",
    "preview": "vite preview",
    "package:win": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.workbench.desktop",
    "productName": "Workbench",
    "directories": {
      "output": "Releases/Release-Test V0.01"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Workbench.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Workbench-mac-${arch}.zip"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "adm-zip": "^0.6.1",
    "docx": "^9.8.0",
    "docx-preview": "^0.4.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
